ENVIRONMENT=local
PROJECT_VERSION=2026.2
DATABASE_URL=sqlite+aiosqlite:///./rocketlab.db
# true imprime todo SQL executado (útil para estudar as consultas)
DATABASE_ECHO=false
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Credenciais do administrador (único perfil do sistema).
# Valores de DESENVOLVIMENTO: troque antes de expor a aplicação.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=rocketlab
# Gere um segredo forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=480

# Tempo (s) que estatísticas e listas auxiliares ficam em cache
CACHE_TTL_SECONDS=120
